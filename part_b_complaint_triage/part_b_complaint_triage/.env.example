# Copy this file to .env and fill in your key. Never commit .env.
LLM_API_KEY=hskk

# Defaults: Google Gemini (free tier available at aistudio.google.com)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite
LLM_REASONING_EFFORT=low
# Free tier has a requests-per-minute limit; 4 seconds between calls keeps under it.
LLM_SLEEP_SECONDS=4

# Other OpenAI-compatible providers work too, for example:
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1      LLM_MODEL=<model name>  LLM_REASONING_EFFORT=
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1            LLM_MODEL=<model name>  LLM_REASONING_EFFORT=
